{
  "version": 3,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/static(?:/(.*))$",
      "dest": "/static/$1",
      "check": true
    },
    {
      "src": "^(?:/(.*))$",
      "dest": "/functions/index.func",
      "check": true
    },
    {
      "handle": "error"
    },
    {
      "status": 404,
      "src": "^(?!/api).*$",
      "dest": "/404.html"
    }
  ],
  "framework": {
    "slug": "tanstack-start",
    "version": "1.168.12"
  },
  "crons": []
}
